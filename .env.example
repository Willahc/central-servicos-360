# CONFIGURAÇÕES DO SERVIDOR (FASE 1)
PORT=3000
NODE_ENV=development
APP_NAME=Central de Serviços 360 CORE

# AUTENTICAÇÃO SSO & JWT
JWT_SECRET=cs360_super_secret_jwt_key_fase1_change_in_prod
SSO_PROVIDER_URL=https://identity.siriolibanes.org.br

# ADAPTADORES SIMULADOS (MOCKS)
MOCK_MODE=true
ARGO_MOCK_ENABLED=true
UBER_MOCK_ENABLED=true
CORREIOS_MOCK_ENABLED=true
XEROX_MOCK_ENABLED=true

# BANCO DE DADOS (POSTGRESQL FASE 1)
DATABASE_URL=postgresql://cs360_user:cs360_password@localhost:5432/cs360_db?schema=public
