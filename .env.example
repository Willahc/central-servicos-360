# CONFIGURAÇÕES DO SERVIDOR (FASE 1B - MVP LOCAL)
PORT=3000
NODE_ENV=development
APP_NAME=Central de Serviços 360 CORE

# AUTENTICAÇÃO (MOCK - apenas para demonstração local)
# ATENÇÃO: Não usar este sistema em produção. Autenticação real deve usar SSO corporativo.
MOCK_AUTH=true
JWT_SECRET=change_me_local_only

# CORS (origens permitidas para execução local, separadas por vírgula)
CORS_ORIGINS=http://localhost:3000

# MODO DE OPERAÇÃO
MOCK_MODE=true

# ADAPTADORES SIMULADOS (MOCKS)
ARGO_MOCK_ENABLED=true
UBER_MOCK_ENABLED=true
CORREIOS_MOCK_ENABLED=true
XEROX_MOCK_ENABLED=true

# BANCO DE DADOS (placeholder - não utilizado na Fase 1B)
DATABASE_URL=postgresql://example_user:example_password@localhost:5432/example_db?schema=public
DB_HOST=localhost
DB_USER=example_user
DB_PASSWORD=example_password

# PROVEDOR DE IDENTIDADE (placeholder - não utilizado na Fase 1B)
IDENTITY_PROVIDER_URL=https://example.invalid
